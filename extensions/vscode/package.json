{
  "name": "porter-vscode",
  "displayName": "Porter",
  "description": "Shows this window's Claude Code and Codex conversation tabs to the Porter Mac app and brings the one you choose forward. Reads no conversation content; talks only to Porter on this Mac.",
  "version": "0.1.0",
  "publisher": "porter-dev",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "porter.showStatus",
        "title": "Porter: Show connection status"
      },
      {
        "command": "porter.listTabs",
        "title": "Porter: List conversation tabs in this window"
      },
      {
        "command": "porter.describeTabs",
        "title": "Porter: Describe all tabs in this window (diagnostic)"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/tests/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/vscode": "1.94.0",
    "typescript": "^7.0.2"
  },
  "activationEvents": [
    "onStartupFinished"
  ]
}
