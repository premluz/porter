{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.porter.invalid/v1/common.schema.json",
  "title": "Porter shared contract definitions",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "opaqueId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "revision": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "protocolVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "httpsUrl": { "type": "string", "maxLength": 2048, "pattern": "^https://[^\\s]+$" },
    "deepLink": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]*$",
      "not": { "pattern": "^(file|https?|javascript|data):" }
    },
    "bundleId": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$" },
    "activity": { "enum": ["working", "idle", "unknown"] },
    "attention": { "enum": ["needsUser", "newResponse", "none", "unknown"] },
    "reachability": { "enum": ["connected", "disconnected", "unavailable"] },
    "freshness": { "enum": ["fresh", "stale", "unknown"] },
    "evidenceKind": { "enum": ["providerEvent", "domSignal", "userAcknowledged", "none"] },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "supported"],
      "properties": {
        "name": { "enum": ["discover", "observeStatus", "activate", "openMobile", "readPreview", "draft", "send"] },
        "supported": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/label" }
      }
    }
  }
}
