{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.porter.invalid/v1/bridge-control.schema.json",
  "$defs": {
    "activateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "destinationId",
        "destinationRevision",
        "expectedProvider",
        "expectedConversationId"
      ],
      "properties": {
        "requestId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "destinationId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "destinationRevision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "tabId": {
          "type": "integer",
          "minimum": 0
        },
        "windowId": {
          "type": "integer",
          "minimum": 0
        },
        "expectedProvider": {
          "$ref": "common.schema.json#/$defs/provider"
        },
        "expectedConversationId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "editor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspacePath",
            "viewColumn",
            "index",
            "expectedTitle"
          ],
          "properties": {
            "workspacePath": {
              "type": "string",
              "minLength": 2,
              "maxLength": 1024,
              "pattern": "^/[^\\u0000]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "viewColumn": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "expectedTitle": {
              "$ref": "common.schema.json#/$defs/title"
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundleId",
            "expectedTitle",
            "ordinal"
          ],
          "properties": {
            "bundleId": {
              "$ref": "common.schema.json#/$defs/bundleId"
            },
            "expectedTitle": {
              "$ref": "common.schema.json#/$defs/title"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 199
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "tabId",
            "windowId"
          ]
        },
        {
          "required": [
            "editor"
          ]
        },
        {
          "required": [
            "app"
          ]
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "malformed",
            "unsupportedVersion",
            "unauthorized",
            "duplicateInstallation",
            "outOfOrder",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
