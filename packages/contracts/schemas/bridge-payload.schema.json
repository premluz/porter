{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.porter.invalid/v1/bridge-payload.schema.json",
  "title": "Bridge payloads",
  "description": "Payload of each envelope type, selected by the envelope's type. Connectors report only tabs their adapter recognizes as supported conversations, never general browsing.",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/helloAck"
    },
    {
      "$ref": "#/$defs/inventorySnapshot"
    },
    {
      "$ref": "#/$defs/destinationUpsert"
    },
    {
      "$ref": "#/$defs/destinationRemove"
    },
    {
      "$ref": "#/$defs/empty"
    },
    {
      "$ref": "#/$defs/activateRequest"
    },
    {
      "$ref": "activation-result.schema.json"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "tabReport": {
      "$ref": "bridge-reports.schema.json#/$defs/tabReport"
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installationId",
        "adapterVersions"
      ],
      "properties": {
        "installationId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "profileAlias": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "adapterVersions": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/provider"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/version"
          }
        },
        "connectorKind": {
          "enum": [
            "chrome",
            "vscode",
            "chromeScripting",
            "desktopApp"
          ]
        }
      }
    },
    "helloAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "const": true
        },
        "connectorId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        }
      }
    },
    "inventorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tabs"
      ],
      "properties": {
        "tabs": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/tabReport"
          }
        },
        "editorTabs": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/editorTabReport"
          }
        },
        "appEntries": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/appEntryReport"
          }
        }
      }
    },
    "destinationUpsert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab"
      ],
      "properties": {
        "tab": {
          "$ref": "#/$defs/tabReport"
        }
      }
    },
    "destinationRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tabId"
      ],
      "properties": {
        "tabId": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "activateRequest": {
      "$ref": "bridge-control.schema.json#/$defs/activateRequest"
    },
    "error": {
      "$ref": "bridge-control.schema.json#/$defs/error"
    },
    "editorTabReport": {
      "$ref": "bridge-reports.schema.json#/$defs/editorTabReport"
    },
    "appEntryReport": {
      "$ref": "bridge-reports.schema.json#/$defs/appEntryReport"
    }
  }
}
