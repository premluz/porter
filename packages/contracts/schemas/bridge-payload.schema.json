{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.porter.invalid/v1/bridge-payload.schema.json",
  "title": "Bridge payloads",
  "description": "Payload of each envelope type, selected by the envelope's type. Connectors report only tabs their adapter recognizes as supported conversations, never general browsing.",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/helloAck"
    },
    {
      "$ref": "#/$defs/inventorySnapshot"
    },
    {
      "$ref": "#/$defs/destinationUpsert"
    },
    {
      "$ref": "#/$defs/destinationRemove"
    },
    {
      "$ref": "#/$defs/empty"
    },
    {
      "$ref": "#/$defs/activateRequest"
    },
    {
      "$ref": "activation-result.schema.json"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "tabReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tabId",
        "windowId",
        "provider",
        "providerConversationId",
        "title",
        "canonicalUrl"
      ],
      "properties": {
        "tabId": {
          "type": "integer",
          "minimum": 0
        },
        "windowId": {
          "type": "integer",
          "minimum": 0
        },
        "provider": {
          "$ref": "common.schema.json#/$defs/provider"
        },
        "providerConversationId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/title"
        },
        "canonicalUrl": {
          "$ref": "common.schema.json#/$defs/httpsUrl"
        },
        "lastActiveAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installationId",
        "adapterVersions"
      ],
      "properties": {
        "installationId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "profileAlias": {
          "$ref": "common.schema.json#/$defs/label"
        },
        "adapterVersions": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/provider"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/version"
          }
        },
        "connectorKind": {
          "enum": [
            "chrome",
            "vscode",
            "chromeScripting",
            "desktopApp"
          ]
        }
      }
    },
    "helloAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "const": true
        },
        "connectorId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        }
      }
    },
    "inventorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tabs"
      ],
      "properties": {
        "tabs": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/tabReport"
          }
        },
        "editorTabs": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/editorTabReport"
          }
        },
        "appEntries": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/appEntryReport"
          }
        }
      }
    },
    "destinationUpsert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab"
      ],
      "properties": {
        "tab": {
          "$ref": "#/$defs/tabReport"
        }
      }
    },
    "destinationRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tabId"
      ],
      "properties": {
        "tabId": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "activateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "destinationId",
        "destinationRevision",
        "expectedProvider",
        "expectedConversationId"
      ],
      "properties": {
        "requestId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "destinationId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "destinationRevision": {
          "$ref": "common.schema.json#/$defs/revision"
        },
        "tabId": {
          "type": "integer",
          "minimum": 0
        },
        "windowId": {
          "type": "integer",
          "minimum": 0
        },
        "expectedProvider": {
          "$ref": "common.schema.json#/$defs/provider"
        },
        "expectedConversationId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "editor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workspacePath",
            "viewColumn",
            "index",
            "expectedTitle"
          ],
          "properties": {
            "workspacePath": {
              "type": "string",
              "minLength": 2,
              "maxLength": 1024,
              "pattern": "^/[^\\u0000]*$",
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            },
            "viewColumn": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "expectedTitle": {
              "$ref": "common.schema.json#/$defs/title"
            }
          }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundleId",
            "expectedTitle",
            "ordinal"
          ],
          "properties": {
            "bundleId": {
              "$ref": "common.schema.json#/$defs/bundleId"
            },
            "expectedTitle": {
              "$ref": "common.schema.json#/$defs/title"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 199
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "tabId",
            "windowId"
          ]
        },
        {
          "required": [
            "editor"
          ]
        },
        {
          "required": [
            "app"
          ]
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "malformed",
            "unsupportedVersion",
            "unauthorized",
            "duplicateInstallation",
            "outOfOrder",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "editorTabReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "providerConversationId",
        "title",
        "workspacePath",
        "viewColumn",
        "index"
      ],
      "properties": {
        "provider": {
          "$ref": "common.schema.json#/$defs/provider"
        },
        "providerConversationId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/title"
        },
        "workspacePath": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1024,
          "pattern": "^/[^\\u0000]*$",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        "viewColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "lastActiveAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "appEntryReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "providerConversationId",
        "title",
        "bundleId",
        "ordinal"
      ],
      "properties": {
        "provider": {
          "$ref": "common.schema.json#/$defs/provider"
        },
        "providerConversationId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/title"
        },
        "bundleId": {
          "$ref": "common.schema.json#/$defs/bundleId"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 199
        },
        "unread": {
          "type": "boolean"
        },
        "lastActiveAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    }
  }
}
